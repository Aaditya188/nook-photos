# deps
node_modules/
.pnp
.pnp.js

# builds
dist/
build/
web-build/
.expo/
.expo-shared/
apps/mobile/.expo/
apps/web/dist/
packages/*/dist/
*.tsbuildinfo

# Stray Expo/EAS config that lands at the repo ROOT when `eas`/`expo` is run here
# instead of in apps/mobile. The real app config lives in apps/mobile; a root
# copy is always accidental (and breaks builds). Anchored with a leading slash so
# apps/mobile/app.json and apps/mobile/eas.json are untouched.
/app.json
/eas.json

# python bytecode (the indexer runs in-place, so these appear on every boot)
__pycache__/
*.py[cod]

# native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
ios/
android/

# env / secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# server data (never commit the photo store)
apps/server/data/
data/

# service logs
apps/*/logs/
*.log
.gstack/
